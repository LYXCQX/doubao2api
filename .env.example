# ===================================================================
# Doubao 2API - 环境变量配置文件模板
# 复制本文件为 .env 并根据需求调整：
# cp .env.example .env
# ===================================================================

# 服务监听端口 (默认 9090)
DOUBAO_PORT=9090

# 服务监听地址 (本地运行用 127.0.0.1，Docker/远程服务器用 0.0.0.0)
DOUBAO_HOST=127.0.0.1

# 浏览器运行模式:
# - auto: 智能模式（推荐）。未登录时自动弹出桌面窗口引导扫码登录；已登录则静默后台无头运行。
# - true: 强制无头模式（不显示任何窗口，适合 Linux/Docker 无图形界面服务器）。
# - false: 强制桌面窗口模式（始终显示真实浏览器窗口）。
DOUBAO_HEADLESS=auto

# API 访问密钥 (留空则不鉴权；设置后调用 /v1/* 需带 Authorization: Bearer <API_KEY>)
DOUBAO_API_KEY=

# 浏览器会话持久化数据目录 (保存登录 Cookie 与浏览器指纹，默认在用户家目录下)
# DOUBAO_BROWSER_DATA=~/.doubao_browser

# API 每分钟最大请求频率 (RPM 限制，默认 30)
DOUBAO_RPM_LIMIT=30

# 单次请求超时时间 (秒，默认 180)
DOUBAO_TIMEOUT=180

# 即用即焚模式 (默认 true: 每次请求完成后自动在豆包云端删除该临时对话，保持左侧对话列表干净)
DOUBAO_AUTO_DELETE_CONV=true

